apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: fluent-bit-agent
  namespace: qa
  labels:
    app: fluent-bit

spec:
  selector:
    matchLabels:
      app: fluent-bit

  template:
    metadata:
      labels:
        app: fluent-bit

    spec:
      containers:
        - name: fluent-bit
          image: cr.fluentbit.io/fluent/fluent-bit:3.2

          args:
            - -i
            - tail
            - -p
            - path=/var/log/containers/*.log
            - -o
            - stdout

          volumeMounts:
            - name: container-logs
              mountPath: /var/log
              readOnly: true

      volumes:
        - name: container-logs
          hostPath:
            path: /var/log
            type: Directory